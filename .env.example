# Polymarket CLOB v2 — Environment Configuration Template
# Copy this file to .env and fill in the values below.
# IMPORTANT: JWT_SECRET_KEY MUST be set via environment variable, NOT in this file.
#   Set it in your shell before running:
#     export JWT_SECRET_KEY=$(python -c "import secrets; print(secrets.token_urlsafe(64))")
# or on Windows:
#     set JWT_SECRET_KEY=your_secret_key_here

GAMMA_API=https://gamma-api.polymarket.com
POLYMARKET_HOST=https://clob.polymarket.com
POLYGON_RPC_URL=https://polygon-bor.publicnode.com

# Wallet credentials（填入后将由 runtime_config 读取；本地运行也会加载 .env）
SIGNATURE_TYPE=2
API_KEY=your_api_key_here
API_SECRET=your_api_secret_here
API_PASSPHRASE=your_api_passphrase_here
WALLET_PRIVATE_KEY=your_private_key_here
FUNDER_ADDRESS=your_funder_address_here
SIGNER_ADDRESS=your_signer_address_here

# Runtime flags
LIVE_MODE=false
LIVE_SLIPPAGE_PCT=2.0
BTC_SLIPPAGE_PCT=1.0
ETH_SLIPPAGE_PCT=2.0
MIN_EXIT_PRICE=0.01
DEFAULT_FEE_BPS=30

# Strategy parameters
ASSETS=BTC,ETH
MARKET_INTERVAL_SLUG=15m
MARKET_DURATION_SEC=900
ASSET_BTC_ENABLED=true
ASSET_ETH_ENABLED=false

# 单持仓首单金额（USDC）
ENTRY_BASE_USDC=4.0

# 入场截止：窗口开启后超过此时长则禁止开单（秒）
ENTRY_SKIP_IF_LATE=true
ENTRY_EARLY_START_ELAPSED_SEC=0
ENTRY_LATE_CUTOFF_ELAPSED_SEC=540

# 入场价格过滤
ENTRY_PRICE_MIN=0.20
ENTRY_PRICE_MAX=0.60
# 流动性过滤
MIN_DEPTH_COVERAGE=2.0
MAX_SLIPPAGE_PCT=3.0
OBI_CONTRADICT_SKIP=0.25
# OI 变化显著阈值（30 分钟窗口）
OI_CHANGE_SIGNIFICANT=0.02

# Core 6 信号共识门槛（只统计与主方向一致的信号）
CORE_AGREE_THRESHOLD=3
CORE_AGREE_STANDARD=3
# 与主方向相反的 Core 信号数量上限（超过则跳过）
CORE_CONTRADICT_LIMIT=1
# 可选的 CLOB 价格方向确认
ENTRY_REQUIRE_PRICE_ALIGNMENT=false
ENTRY_PRICE_ALIGNMENT_MIN_DEV=0.02
# 按 Core 共识数量配置仓位倍数（相对 ENTRY_BASE_USDC）
STAKE_MULT_CORE3=0.5
STAKE_MULT_CORE4=1.0
STAKE_MULT_CORE5=1.5
STAKE_MULT_CORE6=2.0
# 可选：历史胜率 + 分数 Kelly 仓位
USE_KELLY_SIZING=false
KELLY_FRACTION=0.25
KELLY_PRIOR_WEIGHT=20
KELLY_MIN_SAMPLES=20
KELLY_MAX_MULT=2.0
BANKROLL_USDC=100.0

# ── 因子模型（0=off, 1=shadow, 2=live）────────────────────────────────
FACTOR_MODE=0
FACTOR_W_TREND=0.20
FACTOR_W_REVERSION=0.15
FACTOR_W_PRICE=0.35
FACTOR_W_MICRO=0.15
FACTOR_W_FLOW=0.15
FACTOR_MIN_NET=0.25
FACTOR_MIN_AGREEMENT=0.60
FACTOR_REV_VETO_SCORE=0.70
FACTOR_MAX_SPREAD_BPS=100
FACTOR_OI_CHANGE_THRESHOLD=0.02

# 止盈止损（per trading-guide.md）
# TP = tp_base + tp_range * (entry_price_max - entry) / range
TP_BASE_PCT=10.0
TP_RANGE_PCT=20.0
TP_ENTRY_PRICE_MIN=0.20
TP_ENTRY_PRICE_MAX=0.60
SL_BASE_PCT=-10.0

# ── 主策略出场策略（用于 A/B 测试）────────────────────────────────────
# 完全持有到结算（忽略 TP/SL）
EXIT_HOLD_TO_SETTLEMENT=false
EXIT_TP_ENABLED=true
EXIT_SL_ENABLED=true
# >0：窗口 elapsed 超过该秒数后不再触发 TP/SL，交给结算
EXIT_TP_SL_DISABLE_AFTER_ELAPSED_SEC=0
# TP 上移 / SL 下移的百分点，用于覆盖手续费和滑点
EXIT_COST_BUFFER_PCT=0.0
# 移动止损（0 = 关闭；激活浮盈、回撤百分点）
EXIT_TRAILING_STOP_PCT=0
EXIT_TRAILING_ACTIVATION_PCT=20.0

# ── 主策略风控 ───────────────────────────────────────────────────────
MAIN_MAX_DAILY_LOSS_USDC=-20.0
MAIN_MAX_CONSECUTIVE_LOSSES=3
MAIN_LOSS_COOLDOWN_SEC=900
# 全局最大同时持仓数（主策略持仓 + 待结算）
MAX_OPEN_POSITIONS_TOTAL=4

# 轮询间隔（秒）
POLL_INTERVAL_SEC=1.0
SETTLE_GRACE_SEC=90
MAX_SETTLE_WAIT_SEC=600
SELL_MAX_RETRY_COUNT=3

# Auth
# JWT_SECRET_KEY MUST be set via environment variable only — DO NOT put it here.
# 若未设置 JWT_SECRET_KEY 但设置了 WEB_PASSWORD，会从 WEB_PASSWORD 派生。
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Web 登录管理员（推荐在 Coolify 面板的环境变量中设置）。
# 设置后，应用启动时会创建/更新该 admin 用户，密码以环境变量为准。
WEB_USERNAME=admin
WEB_PASSWORD=
# 可选：首次创建用户（第一个 admin）时要求提供的初始化口令。
# 设置后，注册/首次登录必须携带 setup_token（body 或 X-Setup-Token 头）。
SETUP_TOKEN=

# HTTP server
# 本地默认只监听 127.0.0.1；容器中 Dockerfile/docker-compose 会设置 HOST=0.0.0.0。
HOST=127.0.0.1
PORT=8019

# Database
DATABASE_URL=sqlite+aiosqlite:///data/polymarket.db
