# Polymart2 Docker Environment
#
# Key naming conventions:
#   - Uppercase with _SEC / _PCT / _ENABLED suffix → read by runtime_config.py via os.environ
#   - All booleans use true/false (not 1/0)
#
# NOTE: JWT_SECRET_KEY must be set via docker-compose environment or shell before starting.
#   Set it via:  export JWT_SECRET_KEY=$(python -c "import secrets; print(secrets.token_urlsafe(64))")


# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=dtpq0mWzjnK0FmvYnXOC5O0ywqhp9d5hICMOx9xPrib5rTlIHEgfaf80z13wBo05L4GKdhIUUB-BW1LwXELExQ
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Polymarket API endpoints ─────────────────────────────────────────────────
GAMMA_API=https://gamma-api.polymarket.com
POLYMARKET_HOST=https://clob.polymarket.com
POLYGON_RPC_URL=https://polygon-bor.publicnode.com

# ── Wallet credentials (filled by UI connect-wallet flow) ───────────────────
SIGNATURE_TYPE=2
API_KEY=
API_SECRET=
API_PASSPHRASE=
SIGNER_ADDRESS=
FUNDER_ADDRESS=

# ── Market ───────────────────────────────────────────────────────────────────
# runtime_config key: market_interval_slug → env: MARKET_INTERVAL_SLUG
MARKET_INTERVAL_SLUG=15m
# runtime_config key: market_duration_sec → env: MARKET_DURATION_SEC
MARKET_DURATION_SEC=900
# runtime_config key: asset_btc_enabled → env: ASSET_BTC_ENABLED
# NOTE: config.py also reads TRADE_ASSET_BTC=true (pydantic alias)
ASSET_BTC_ENABLED=true
ASSET_ETH_ENABLED=false
TRADE_ASSET_BTC=true
TRADE_ASSET_ETH=false

# ── Runtime flags ─────────────────────────────────────────────────────────────
# runtime_config key: live_mode → env: LIVE_MODE
LIVE_MODE=false
# runtime_config key: live_slippage_pct → env: LIVE_SLIPPAGE_PCT
LIVE_SLIPPAGE_PCT=2.0
# runtime_config key: min_exit_price → env: MIN_EXIT_PRICE
MIN_EXIT_PRICE=0.01

# ── Entry ─────────────────────────────────────────────────────────────────────
# runtime_config key: entry_base_usdc → env: ENTRY_BASE_USDC
ENTRY_BASE_USDC=4.0
# runtime_config key: entry_skip_if_late → env: ENTRY_SKIP_IF_LATE
ENTRY_SKIP_IF_LATE=true
# runtime_config key: entry_early_start_elapsed_sec → env: ENTRY_EARLY_START_ELAPSED_SEC
ENTRY_EARLY_START_ELAPSED_SEC=0.0
# runtime_config key: entry_late_cutoff_elapsed_sec → env: ENTRY_LATE_CUTOFF_ELAPSED_SEC
# IMPORTANT: 9 minutes (540s) per smart-exit-strategy.md §2.5
ENTRY_LATE_CUTOFF_ELAPSED_SEC=540

# ── Signal-driven entry ───────────────────────────────────────────────────────
# runtime_config key: core_agree_threshold → env: CORE_AGREE_THRESHOLD
CORE_AGREE_THRESHOLD=3
# runtime_config key: core_agree_standard → env: CORE_AGREE_STANDARD
CORE_AGREE_STANDARD=3
# runtime_config key: entry_price_min → env: ENTRY_PRICE_MIN
ENTRY_PRICE_MIN=0.20
# runtime_config key: entry_price_max → env: ENTRY_PRICE_MAX
ENTRY_PRICE_MAX=0.60

# ── Take-profit / Stop-loss ───────────────────────────────────────────────────
# runtime_config key: tp_base_pct → env: TP_BASE_PCT
#   TP = tp_base_pct + tp_range_pct * (tp_entry_price_max - entry) / (tp_entry_price_max - tp_entry_price_min)
TP_BASE_PCT=65.0
# runtime_config key: tp_range_pct → env: TP_RANGE_PCT
TP_RANGE_PCT=20.0
# runtime_config key: entry_price_min_tp → env: TP_ENTRY_PRICE_MIN
TP_ENTRY_PRICE_MIN=0.20
# runtime_config key: entry_price_max_tp → env: TP_ENTRY_PRICE_MAX
TP_ENTRY_PRICE_MAX=0.60
# runtime_config key: sl_base_pct → env: SL_BASE_PCT
SL_BASE_PCT=-10.0
# runtime_config key: trailing_activate_pct → env: TRAILING_ACTIVATE_PCT
TRAILING_ACTIVATE_PCT=70.0

# ── Exit dynamic thresholds (exit_controller._compute_realtime_signal) ───────────
# runtime_config key: tp1_base_pct → env: TP1_BASE_PCT
#   Dynamic TP1 = tp1_base_pct * min(atr_mult, atr_mult_max) * trend_mult, floor 8%
TP1_BASE_PCT=8.0
# runtime_config key: tp2_base_pct → env: TP2_BASE_PCT
#   Dynamic TP2 = tp2_base_pct * min(atr_mult, atr_mult_max) * trend_mult, floor tp1+5%
TP2_BASE_PCT=20.0
# runtime_config key: trailing_gap_base → env: TRAILING_GAP_BASE
#   trailing_gap = trailing_gap_base / trend_mult (strong trend → wider gap)
TRAILING_GAP_BASE=0.20
# runtime_config key: atr_mult_max → env: ATR_MULT_MAX
#   ATR multiplier cap — prevents TP from inflating too much in volatile markets
ATR_MULT_MAX=2.0
# runtime_config key: trailing_gap_pct → env: TRAILING_GAP_PCT
#   Mobile stop-loss: entry-price drawdown % (e.g. 25 means exit when price drops 25% from entry)
TRAILING_GAP_PCT=25.0

# ── Execution ───────────────────────────────────────────────────────────────
# runtime_config key: btc_slippage_pct → env: BTC_SLIPPAGE_PCT
BTC_SLIPPAGE_PCT=1.0
# runtime_config key: eth_slippage_pct → env: ETH_SLIPPAGE_PCT
ETH_SLIPPAGE_PCT=2.0
# runtime_config key: default_fee_bps → env: DEFAULT_FEE_BPS
DEFAULT_FEE_BPS=30
# runtime_config key: sell_max_retry_count → env: SELL_MAX_RETRY_COUNT
SELL_MAX_RETRY_COUNT=3

# ── Settlement ───────────────────────────────────────────────────────────────
# runtime_config key: poll_interval_sec → env: POLL_INTERVAL_SEC
POLL_INTERVAL_SEC=1.0
# runtime_config key: settle_grace_sec → env: SETTLE_GRACE_SEC
SETTLE_GRACE_SEC=120
# runtime_config key: max_settle_wait_sec → env: MAX_SETTLE_WAIT_SEC
MAX_SETTLE_WAIT_SEC=900

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///data/polymarket.db
